<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../src/FishSyncClient.csproj" />
    <EmbeddedResource Include="../config/config.json" LogicalName="FishSyncClient.Cli.Defaults.config.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
    <PackageReference Include="FishBucket" Version="0.1.0" />
    <PackageReference Include="FishBucket.ApiClient" Version="0.1.0" />
    <PackageReference Include="FishBucket.SyncClient" Version="0.1.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
